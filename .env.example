# ═══════════════════════════════════════════
# Production AI Engineering Platform — .env
# Copy to .env and fill in real values
# NEVER commit .env to git
#
# Last updated: D16/CP2.m (2026-05-08) — comprehensive coverage of the
# full Settings surface in backend/app/core/config.py plus the env-only
# OUTREACH_* keys read directly from os.environ in
# backend/app/services/outreach_email_service.py.
#
# Every key is annotated [REQUIRED in production] / [OPTIONAL — default]
# / [DEV-ONLY] so an operator setting up Fly secrets has no ambiguity.
#
# In production, app/core/config.py runs a `production_required`
# validator at boot that refuses to start if any of SECRET_KEY,
# ANTHROPIC_API_KEY, DATABASE_URL, REDIS_URL is missing or contains a
# dev-default fragment (changeme, postgres:postgres, etc.). Fix-loud
# at boot is the design goal.
# ═══════════════════════════════════════════

# ── Environment ──
# Controls the production_required validator. Anything except "production"
# (case-insensitive) skips validation. [REQUIRED]
ENVIRONMENT=development

# Toggle FastAPI debug routes / verbose tracebacks. [OPTIONAL — false]
DEBUG=false

# ── Database (Postgres 16 + pgvector) ──
# Settings reads POSTGRES_* fields and constructs database_url from them.
# A managed connection string (Neon, RDS) goes via these four fields too.
# [REQUIRED in production]
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=platform
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# Connection-pool tuning. [OPTIONAL — defaults shown]
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=1800

# ── Redis 7 (cache + Celery broker + escalation limiter) ──
# [REQUIRED in production]
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
# Key prefix prevents cross-environment collisions when sharing a Redis. [OPTIONAL]
REDIS_KEY_PREFIX=pae

# ── JWT / Auth ──
# Min 32 chars, must NOT contain dev-default fragments. Generate with:
#   openssl rand -hex 32
# [REQUIRED in production]
SECRET_KEY=changeme-in-production-at-least-32-chars-long
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480
REFRESH_TOKEN_EXPIRE_DAYS=7

# ── CORS allowlist (PR3/D3.1) ──
# Comma-separated origins OR JSON array. Wildcard "*" rejected at boot
# in production because allow_credentials=True forbids it.
# [REQUIRED in production — must be explicit list of HTTPS origins]
CORS_ORIGINS=http://localhost:3000

# ── LLM providers ──
# MiniMax checked first if set; Anthropic is the documented fallback.
# At least one of the two MUST be set in production.
# [REQUIRED in production: ANTHROPIC_API_KEY (or MINIMAX_API_KEY)]
ANTHROPIC_API_KEY=
MINIMAX_API_KEY=
MINIMAX_API_BASE_URL=https://api.minimax.io/anthropic
MINIMAX_MODEL=MiniMax-M2.7

# ── Voyage embeddings (memory primitive) ──
# Falls back to deterministic hash when unset (dev / CI). [OPTIONAL]
VOYAGE_API_KEY=
EMBEDDINGS_MODEL=voyage-3

# ── Email (SendGrid) ──
# When SENDGRID_API_KEY is unset, outreach_email_service writes
# status='mocked' to outreach_log and skips the network call —
# dev parity with prod. [OPTIONAL — required for real email]
SENDGRID_API_KEY=
SENDGRID_FROM_EMAIL=noreply@pae.dev

# Direct env reads in outreach_email_service.py:55-57
# (NOT exposed via Settings; set via env or Fly secrets directly).
# [OPTIONAL — defaults shown]
OUTREACH_FROM_EMAIL=team@pae-platform.dev
OUTREACH_FROM_NAME=PAE Platform
OUTREACH_REPLY_TO=bhaskar@pae-platform.dev

# Direct env read in outreach_automation Celery task. Default is
# DRY-RUN: writes outreach_log rows with status='would_send' but
# does NOT call SendGrid. Must be set to "1" AND ENVIRONMENT=production
# for the F9 nightly automation to actually send.
# [OPTIONAL — only flip to 1 in production after smoke-testing]
OUTREACH_AUTO_SEND=

# ── Payments — Razorpay (default in INR) ──
# [REQUIRED in production for paid signup flow]
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
PAYMENTS_DEFAULT_PROVIDER=razorpay
PAYMENTS_DEFAULT_CURRENCY=INR

# Frontend reads ONLY the public key id (NEXT_PUBLIC_RAZORPAY_KEY_ID).

# ── Payments — Stripe (legacy / fallback) ──
# [OPTIONAL — only required if Stripe is enabled in product flow]
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRO_PRICE_ID=price_pro_test
STRIPE_TEAM_PRICE_ID=price_team_test

# ── OAuth (GitHub login) ──
# [OPTIONAL — only required if GitHub social login is enabled]
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# ── OAuth (Google login) ──
# [OPTIONAL — only required if Google social login is enabled]
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── Course content (private GitHub repo proxy) ──
# Distinct from GITHUB_TOKEN; this PAT reads the private content repo
# only. Empty = course content APIs return 503. [REQUIRED in production
# if course content is served]
GITHUB_CONTENT_TOKEN=
GITHUB_CONTENT_REPO=
GITHUB_CONTENT_BRANCH=main

# ── GitHub general API access (PR creation, issue triage agents) ──
# [OPTIONAL]
GITHUB_TOKEN=

# ── GitHub webhook signature verification ──
# Distinct from GITHUB_TOKEN. Set in the GitHub repo/org webhook UI;
# payloads are HMAC-SHA256 signed. Empty = signature verification
# rejects all requests (safe default for unconfigured envs). [REQUIRED
# in production if webhooks are wired]
GITHUB_WEBHOOK_SECRET=

# ── Pinecone (RAG, Phase 6) ──
# [OPTIONAL — Phase 6 deliverable; not yet load-bearing]
PINECONE_API_KEY=

# ── Meilisearch (search) ──
# [REQUIRED in production for search-backed UIs]
MEILISEARCH_HOST=http://localhost:7700
MEILISEARCH_MASTER_KEY=masterKey123

# ── Celery (broker + result backend) ──
# Default to the same Redis as the app (DB index 1 for broker, 2 for
# results). Override for Fly worker/beat apps if a separate broker
# Redis is provisioned. [OPTIONAL — defaults derive from REDIS_HOST]
CELERY_BROKER_URL=
CELERY_RESULT_BACKEND=

# ── Agentic OS — escalation limiter backend ──
# `redis` (default): per-agent sliding-window counter; multi-worker safe.
# `in_memory`: process-local; over-grants by N× worker count. Fallback
#   for tests / dev without Redis.
# Fail-open contract: when Redis is unreachable at runtime, the limiter
# degrades to permissive (escalate everything) with a warning, not block.
# [OPTIONAL — default redis]
ESCALATION_LIMITER_BACKEND=redis

# ── Agentic OS — call-depth ceiling ──
# Hard cap on inter-agent recursion. Default 5: enough headroom for
# legitimate composition; tight enough to surface accidental fan-out
# before wall-clock or token budget is eaten. [OPTIONAL — defaults shown]
AGENT_CALL_MAX_DEPTH=5
AGENT_CALL_TIMEOUT_SECONDS=30.0

# ── Feature flags ──
# All default to True for the readiness workspace; flip to "false" only
# to use the legacy fallback paths.
# [OPTIONAL — defaults shown]
FEATURE_TAILORED_RESUME_AGENT=false
FEATURE_READINESS_DIAGNOSTIC=true
FEATURE_JD_DECODER=true

# ── Chat attachments (P1-6) ──
# Local dev stores attachment bytes on disk. Production swaps to S3 by
# replacing the AttachmentStorage backend; same env keys apply.
# [OPTIONAL — defaults shown]
ATTACHMENTS_DIR=var/attachments
ATTACHMENTS_MAX_BYTES=10485760
ATTACHMENTS_MAX_PER_MESSAGE=4

# ── Observability — Sentry ──
# Set in Fly secrets per fly.toml comment block. [REQUIRED in production
# for error tracking; OPTIONAL — falls back to no-op if unset]
SENTRY_DSN=
# Optional — if unset, Sentry source-map upload is skipped at build
# time and stack traces stay minified.
SENTRY_AUTH_TOKEN=

# ── Observability — PostHog ──
# [OPTIONAL — used for product analytics; falls back to no-op if unset]
POSTHOG_KEY=
POSTHOG_HOST=

# ── Frontend (set in pae-platform-web Fly secrets, not backend) ──
# These are read by the Next.js app, not by the FastAPI backend, but
# documented here for the operator running both apps.
# Docker stack: nginx proxies :8080 → backend:8000.
# For local uvicorn dev (cd backend && uv run uvicorn app.main:app --reload),
# use http://localhost:8000 instead.
NEXT_PUBLIC_API_URL=http://localhost:8080
NEXT_PUBLIC_RAZORPAY_KEY_ID=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
NEXT_PUBLIC_SENTRY_DSN=
NEXT_PUBLIC_SENTRY_ENV=development
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=

# ── Pre-launch operational checklist (NOT env vars; documentation only) ──
# Before flipping ENVIRONMENT=production:
#   [ ] All [REQUIRED in production] keys above are set in Fly secrets
#   [ ] CORS_ORIGINS contains an explicit comma-separated allowlist
#   [ ] SECRET_KEY is a fresh `openssl rand -hex 32` value (not a default)
#   [ ] OUTREACH_AUTO_SEND remains empty/0 until SendGrid is verified
#       and a smoke send-to-self confirms deliverability
#   [ ] SendGrid sender domain has SPF + DKIM + DMARC verified at the DNS
#       level (operational; cannot be set via env)
#   [ ] Celery worker + beat Fly apps are deployed (see fly-worker.toml,
#       fly-beat.toml). Mirror the secret envelope across all three apps.
#   [ ] After first beat deploy: `fly scale count 1 --app pae-platform-beat`
#       to enforce the singleton-scheduler invariant
